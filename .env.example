# ==============================================================================
# Team bonding Liderzy Jutra - Global Production & Development Environment Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` (or set these environment variables in your cloud host)
# 2. Never commit actual secret keys or production passwords into version control
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Supabase / Neon / AWS RDS / Fly.io Postgres):
# DATABASE_URL="postgresql://username:strong_password@host:5432/teambonding?schema=public&sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY SECRETS
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy cryptographic strings.
# Generate on Linux/macOS/Git Bash: openssl rand -base64 32
# Generate on PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 } | [byte[]]))
JWT_ACCESS_SECRET="replace-with-a-secure-random-32-char-min-access-token-secret"
JWT_REFRESH_SECRET="replace-with-a-secure-random-32-char-min-refresh-token-secret"

# Legacy unified secret fallback (if separate secrets are not configured):
JWT_SECRET="replace-with-a-secure-random-32-char-min-secret"

# ------------------------------------------------------------------------------
# 3. SUPERADMIN SEED CONFIGURATION
# ------------------------------------------------------------------------------
# Accommodation email for platform owner / initial bootstrap:
SEED_ADMIN_EMAIL="tyberiusz.wylon@gmail.com"

# Initial one-time bootstrap temporary password for superadmin.
# Required only for first-time database provisioning.
# If left empty, seed generator outputs a secure one-time token in server console logs.
# User will be required to change this upon initial login.
SEED_ADMIN_INITIAL_TEMP_PASSWORD=""

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Runtime environment ('development' | 'production' | 'test')
NODE_ENV="production"

# Port on which the unified Next.js + Socket.io HTTP server listens
PORT="3000"

# Hostname binding (use "0.0.0.0" for Docker / cloud containers, "localhost" for local)
HOSTNAME="0.0.0.0"

# Next.js telemetry disable (recommended for production containers)
NEXT_TELEMETRY_DISABLED="1"
